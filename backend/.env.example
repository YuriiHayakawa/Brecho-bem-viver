# Configurações da aplicação
APP_NAME="Bazar Interno API"
APP_ENV=production

# Banco de dados (fornecido pelo Railway ao adicionar PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Chave secreta para JWT (gere uma string aleatória longa)
SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria

# Origens permitidas pelo CORS (URL do seu frontend no Vercel)
ALLOWED_ORIGINS=https://seu-projeto.vercel.app
