# ─────────────────────────────────────────────
#  BAZAR INTERNO — .gitignore
#  Stack: FastAPI · SQLAlchemy · PostgreSQL (Docker)
#         React · Vite · Node
# ─────────────────────────────────────────────

# ── Variáveis de ambiente ──────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
.envrc
# manter o exemplo como referência
!.env.example

# ── Python / FastAPI ───────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
__pypackages__/

# Distribuição / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST
.eggs/
develop-eggs/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
.installed.cfg

# Testes / cobertura
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
nosetests.xml
*.cover
*.py.cover
cover/

# Type checkers e linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
.pyright/
cython_debug/

# Ferramentas de empacotamento
.pdm-python
.pdm-build/
.pixi
.abstra/
.pypirc

# ── Node / React / Vite ────────────────────────
node_modules/
frontend/node_modules/

# Build output
frontend/dist/
frontend/build/
frontend/.vite/
*.tsbuildinfo

# Cache Vite / esbuild
.cache/
frontend/.cache/

# Logs npm / yarn / pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Uploads (arquivos enviados pelos usuários) ─
backend/uploads/*
!backend/uploads/.gitkeep

# ── Docker / banco de dados ───────────────────
postgres_data/

# ── Logs gerais ────────────────────────────────
*.log
logs/
pip-log.txt
pip-delete-this-directory.txt
local_settings.py
db.sqlite3
db.sqlite3-journal

# ── Sistema operacional ────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ── Editores / IDEs ────────────────────────────
# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr
out/

# Cursor
.cursorignore
.cursorindexingignore

# Vim / Emacs
*.swp
*.swo
*.swn
*~
\#*\#
.\#*

# ── Miscelânea ─────────────────────────────────
*.bak
*.tmp
*.temp
*.pid
*.seed
*.pid.lock
.sass-cache/
/site
.ipynb_checkpoints
profile_default/
ipython_config.py
